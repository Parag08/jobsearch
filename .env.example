# Copy to .env.local for local dev; set the same names in Vercel for deploys.
# .env.local is gitignored - put real values there yourself, never in chat.
# Values live in the Supabase dashboard (new-style API keys, not legacy JWTs):
#   Project Settings -> API Keys -> "Publishable key" / "Secret keys"
#   Project Settings -> Database -> Connection string (session pooler)

# Safe to expose to the browser (RLS is the guard):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only (no NEXT_PUBLIC_ prefix - never ships to the browser).
# Bypasses RLS; cron/admin paths only.
SUPABASE_SECRET_KEY=sb_secret_...

# Direct Postgres connection for schema deploys (npm run db:apply and the
# db.yml GitHub Action). Session-pooler URI with your DB password inlined.
# Also add this one as a GitHub Actions repo secret named SUPABASE_DB_URL.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# LLM providers (later - see docs/MEMORY.md next steps):
# GEMINI_API_KEY=
# GROQ_API_KEY=
