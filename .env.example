# Copy to .env.local for local dev; set the same names in Vercel for deploys.
# Values live in the Supabase dashboard: Project Settings -> API.

# Safe to expose to the browser (anon key is guarded by RLS):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only (NO NEXT_PUBLIC_ prefix - never ships to the browser).
# Bypasses RLS; used by cron/admin paths only. Keep it out of client code.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# LLM providers (later - see docs/MEMORY.md next steps):
# GEMINI_API_KEY=
# GROQ_API_KEY=
