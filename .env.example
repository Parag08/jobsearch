# Copy to .env.local for local dev; set the same names in Vercel for deploys.
# .env.local is gitignored - put real values there yourself, never in chat.
# Values live in the Supabase dashboard (new-style API keys, not legacy JWTs):
#   Project Settings -> API Keys -> "Publishable key" / "Secret keys"
#   Project Settings -> Database -> Connection string (session pooler)

# Safe to expose to the browser (RLS is the guard):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only (no NEXT_PUBLIC_ prefix - never ships to the browser).
# Bypasses RLS; cron/admin paths and the MCP endpoint (/api/mcp, lib/db/agent.ts), which
# resolves the caller from a personal token and scopes every query to that user itself.
SUPABASE_SECRET_KEY=sb_secret_...

# Direct Postgres connection for schema deploys (npm run db:apply, npm run db:seed
# and the db.yml GitHub Action) - REQUIRED for those: the API keys above cannot run
# DDL. Session-pooler URI with your DB password inlined.
# Scripts read .env.local first, then .env.
# Also add this one as a GitHub Actions repo secret named SUPABASE_DB_URL.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# LLM providers (later - see docs/MEMORY.md next steps):
# GEMINI_API_KEY=
# GROQ_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash            # small tier model override (default shown)
# GROQ_MODEL=llama-3.3-70b-versatile       # small tier fallback model override (default shown)
# Premium tier (polish/outreach) - opt-in, paid. Without it premium routes to the small tier.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5        # premium model override (default shown)

# --- Vercel AI Gateway (preferred) ------------------------------------------------
# One key reaches every provider, billed against the AI credit included with the
# Vercel plan. When this is set it wins over the per-provider keys above.
# Create one: Vercel dashboard -> AI Gateway -> API Keys, or `vercel ai-gateway api-keys create`.
# AI_GATEWAY_API_KEY=
# Models are addressed as provider/model. Defaults shown; check the live catalogue at
# https://ai-gateway.vercel.sh/v1/models (no auth needed).
# AI_GATEWAY_SMALL_MODEL=google/gemini-2.5-flash-lite    # extraction. Chosen on a JSON-mode test:
#   995ms, all 4 fields, 58 completion tokens. Several cheaper models answer 200 then
#   return prose, which extractJd cannot use.
# AI_GATEWAY_PREMIUM_MODEL=mistral/mistral-medium-3.5   # polish + outreach only.
#   anthropic/claude-sonnet-4.5 is better but 403s on a free-tier team; switch to it
#   the moment the team has paid AI Gateway credits.
# AI_GATEWAY_INTERVIEWER_MODEL=anthropic/claude-sonnet-4.5   # the full mock interview's turns:
#   choosing the next question is judgement, so a stronger model than the small tier.
#   Unset = AI_GATEWAY_PREMIUM_MODEL (docs/FULL-INTERVIEW.md).

# --- ElevenLabs (optional): the interviewer's voice -------------------------------
# Spoken practice and the case room read questions aloud. With all five set, lines are
# spoken by ElevenLabs through /api/tts (the key stays on the server; only the
# interviewer's text is sent - your answers never go to ElevenLabs). Leave any unset and
# the browser's own voice is used, at $0. Characters spoken are logged to token_ledger
# as module "interview-tts".
# Key: elevenlabs.io -> Developers -> API Keys (text-to-speech permission is enough).
# Voice: elevenlabs.io -> Voices -> pick one -> copy its Voice ID.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5      # fast, cheapest per character
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# ELEVENLABS_MAX_CHARS=2000                  # longest line one request may send

# Google Tag Manager container (public; loads analytics tags). Leave unset to load no tag.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# CV page fitting (lib/cv-page-settings.ts). All three or none: unset = tailoring skips the
# page fit and never cuts a bullet for space. Overhead = lines that are not bullets (header,
# education, skills, headings) at scale 1. 21 = the master CV (34 bullet lines) filling one A4
# page exactly; every CV in data/cvbuilder/applications fits at this value.
CV_PAGE_SIZE=A4
CV_SCALE=1
CV_OVERHEAD_LINES=21

# CV whole-pool selection (lib/editorial/auto-select.ts, lib/cv-page-settings.ts). All five or
# none: unset = tailoring edits the role-family master instead. Values from the findparagjob CV
# builder: budget 16 (score.js autoSelect); 4 per role so a long role can carry the "3-4 Nutanix" the
# guide allows while the share rule keeps the org to ~1/3, every role keeps >= 1, no org over
# ~1/3 of the bullet lines (docs/cv-writing.md: Nutanix), 0.35 rarity-weighted tag overlap =
# the same story (overlap.js).
CV_MAX_BULLETS=16
CV_MAX_PER_ROLE=4
CV_MIN_PER_ROLE=1
CV_MAX_ORG_SHARE=0.34
CV_COLLISION_OVERLAP=0.35

# Private Supabase storage bucket for exported CVs (migration 0006 creates "cv-exports").
# Unset = downloads still work, but no copy is kept and application_cvs.file_path stays empty.
CV_EXPORT_BUCKET=cv-exports

# Google One Tap on the landing page ("Continue as <name>" for a browser signed in to Google).
# The Web OAuth client ID from Google Cloud -> APIs & Services -> Credentials - the same one
# configured in Supabase -> Auth -> Providers -> Google. Public by design. Unset = no One Tap.
# Its "Authorized JavaScript origins" must list every origin that serves the page.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR-CLIENT-ID.apps.googleusercontent.com

# CV corpus source for `npm run data:sync` (local only): the findparagjob workspace.
FINDPARAGJOB_DIR=

# Pipeline board: the window behind the board's "Only the last N days" link (applied, moved or
# saved in the window). The board always opens on every application. Unset = no such link.
PIPELINE_RECENT_DAYS=7

# Role insights (/app/insights, lib/insights/settings.ts). ROLE_READ_BATCH = how many unread
# roles one click of "Read them" sends to the small model (keeps a request inside the function
# time limit). ROLE_PLAN_MAX_GAPS = how many gaps a drafted plan covers. Unset = that button
# is not offered.
ROLE_READ_BATCH=5
ROLE_PLAN_MAX_GAPS=8

# Public demo (/demo, lib/demo/visitors.ts): a fictional person's workspace, one copy per
# visitor, kept in memory for two idle hours. Every AI feature answers from lib/demo/canned.ts,
# so a visitor never spends a token. DEMO_MAX_VISITORS = sample workspaces one server keeps at
# once. Unset = the demo is off (also the kill switch).
DEMO_MAX_VISITORS=200

# Pipeline board: cards a column shows before the rest fold under "Show N more".
# Unset = every column shows all of its cards.
PIPELINE_COLUMN_MAX=9

# Interview: the longest question you may add under "My own" (lib/interview/custom-questions.ts).
# Unset = adding your own questions is not offered.
INTERVIEW_CUSTOM_QUESTION_MAX_CHARS=300

# Interview: the full mock interview (docs/FULL-INTERVIEW.md, lib/interview/full-plan.ts).
# All three or the full interview is off. Most topics asked in one interview (a real round
# never covers everything), most follow-ups on one topic, most follow-ups in all.
INTERVIEW_FULL_MAX_TOPICS=8
INTERVIEW_FULL_TOPIC_FOLLOW_UPS=3
INTERVIEW_FULL_TOTAL_FOLLOW_UPS=12

# Hands-free turn-taking in the mock interviews (lib/interview/turn-taking.ts). All five or
# hands-free never ends your answer by itself (you press "Done answering"). An answer that
# sounds finished ends after SILENCE_MS of quiet; one that stops mid-sentence ("...at nutanix as")
# or is still under MIN_WORDS words gets UNFINISHED_MS. The mic must also be below QUIET_LEVEL
# (0-1 loudness). Past RAMBLE_WORDS the interviewer cuts in at the next finished phrase.
INTERVIEW_TURN_SILENCE_MS=2500
INTERVIEW_TURN_UNFINISHED_MS=6000
INTERVIEW_TURN_MIN_WORDS=40
INTERVIEW_TURN_RAMBLE_WORDS=280
INTERVIEW_TURN_QUIET_LEVEL=0.05

# Home dashboard (/app/home, lib/home/settings.ts): weekly goals shown as rings. Each is
# optional - unset means no target is shown for it.
HOME_GOAL_APPLY=5
HOME_GOAL_REACH_OUT=3
HOME_GOAL_PRACTISE=4

# Marking an application applied sets its next step to "Follow up if no reply by <date>",
# this many days out (docs/APPLY-FLOW.md step 5). Unset = no follow-up is set.
APPLY_FOLLOW_UP_DAYS=7
